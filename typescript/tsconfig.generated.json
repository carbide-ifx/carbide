{
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "paths": {
      "@carbide-ifx/rpc-sdk": [
        "./rpc-sdk/src/index.ts"
      ],
      "@carbide-ifx/rpc-sdk-jsonrpc": [
        "./rpc-sdk-jsonrpc/src/index.ts"
      ],
      "@carbide-ifx/rpc-sdk-rsocket": [
        "./rpc-sdk-rsocket/src/index.ts"
      ]
    },
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "../build/generated/test.test-system/main/resources/ksp/**/*.ts",
    "generated-sdk-smoke.ts"
  ]
}
